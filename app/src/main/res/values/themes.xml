<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        windowBackground is the only item that does real work here: it paints the cold-start window
        black, before Compose has drawn anything. statusBarColor and navigationBarColor used to sit
        alongside it and were dead — enableEdgeToEdge() overwrites both at onCreate, and
        hideSystemBars() takes the bars away entirely.
    -->
    <style name="Theme.IntervalTimer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
