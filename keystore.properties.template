# Copy this file to `keystore.properties` (which is gitignored) and fill in your own values.
# When keystore.properties is present, release builds are signed with your upload key and are
# valid for the Play Store. When it's absent, release builds fall back to the debug key so they
# still build and install for local testing — but such builds CANNOT be uploaded to Play.
#
# Create the upload keystore first (you choose the passwords — pick strong ones and don't lose them,
# there is no recovery):
#
#   keytool -genkeypair -v -keystore upload-keystore.jks -alias upload \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Then set the four values below. storeFile is relative to the repo root.

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
